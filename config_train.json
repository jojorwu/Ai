{
  "model": {
    "d_model": 64,
    "num_layers": 4,
    "num_heads": 8,
    "num_kv_heads": 2,
    "d_ff": 256,
    "max_seq_len": 128,
    "dropout_rate": 0.1,
    "num_experts": 8,
    "top_k_experts": 2,
    "gradient_checkpointing": false,
    "ltm": {
      "d_hidden": 128,
      "num_layers": 2,
      "surprise_threshold": 1.0,
      "optimizer": {
        "learning_rate": 1e-05,
        "beta1": 0.9,
        "beta2": 0.999,
        "epsilon": 1e-08,
        "weight_decay": 0.01,
        "max_norm": 1.0
      }
    }
  },
  "vision": {
    "image_size": [
      224,
      224
    ],
    "patch_size": 16,
    "num_channels": 3
  },
  "evolution": {
    "pretrain_epochs": 5,
    "evolution_epochs": 10,
    "num_agents": 8,
    "num_survivors": 2,
    "batch_size": 16,
    "seq_len": 32,
    "gradient_accumulation_steps": 1,
    "validation_split": 0.1,
    "data_dir": "data",
    "weights_path": "model_weights.npz",
    "checkpoint_path": "checkpoint.npz",
    "early_stopping_patience": 3,
    "best_model_path": "best_model.npz",
    "moe_aux_loss_coeff": 0.01,
    "label_smoothing": 0.0
  },
  "optimizer": {
    "learning_rate": 0.0001,
    "beta1": 0.9,
    "beta2": 0.999,
    "epsilon": 1E-8,
    "weight_decay": 0.01,
    "max_norm": 1.0
  },
  "ltm": {
    "d_hidden": 128,
    "num_layers": 2,
    "surprise_threshold": 1.0,
    "optimizer": {
      "learning_rate": 0.00001,
      "beta1": 0.9,
      "beta2": 0.999,
      "epsilon": 1E-8,
      "weight_decay": 0.01,
      "max_norm": 1.0
    }
  },
  "scheduler": {
    "warmup_steps": 10,
    "training_steps": 5000,
    "min_lr": 0.00001
  },
  "hardware": {
    "device": "cpu",
    "strategy": "discrete",
    "torch_compile": false
  }
}
