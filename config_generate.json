{
  "model": {
    "d_model": 64,
    "num_layers": 4,
    "num_heads": 8,
    "num_kv_heads": 2,
    "d_ff": 256,
    "max_seq_len": 128,
    "dropout_rate": 0.1,
    "num_experts": 8,
    "top_k_experts": 2,
    "gradient_checkpointing": false
  },
  "vision": {
    "image_size": [
      224,
      224
    ],
    "patch_size": 16,
    "num_channels": 3
  },
  "ltm": {
    "surprise_threshold": 1.0,
    "optimizer": {
      "learning_rate": 0.00001,
      "beta1": 0.9,
      "beta2": 0.999,
      "epsilon": 1E-8,
      "weight_decay": 0.01
    }
  },
  "generation": {
    "start_text": "Пожалуйста, перечисли файлы в текущей директории. Используй инструмент 'list_files'.",
    "max_len": 100,
    "temperature": 0.0,
    "top_k": 1,
    "top_p": 0.0,
    "speculative_steps": 0,
    "value_threshold": -1.0,
    "max_thought_len": 50,
    "max_retries": 3,
    "max_turns": 10,
    "context_window_size": 2048
  },
  "hardware": {
    "device": "cpu",
    "strategy": "discrete",
    "torch_compile": false
  }
}
