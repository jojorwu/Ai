{
    "model": {
        "d_model": 64,
        "num_layers": 4,
        "num_heads": 8,
        "num_kv_heads": 2,
        "d_ff": 256,
        "max_seq_len": 128,
        "dropout_rate": 0.1
    },
    "training": {
        "epochs": 10,
        "batch_size": 2,
        "seq_len": 32,
        "data_dir": "data",
        "weights_path": "model_weights.npz"
    },
    "optimizer": {
        "learning_rate": 0.001,
        "beta1": 0.9,
        "beta2": 0.999,
        "epsilon": 1e-8,
        "max_norm": 1.0
    },
    "generation": {
        "start_text": "Привет",
        "max_len": 50,
        "temperature": 0.8,
        "top_k": 5
    }
}
