{
    "model": {
        "d_model": 64,
        "num_layers": 4,
        "num_heads": 8,
        "num_kv_heads": 2,
        "d_ff": 256,
        "max_seq_len": 128,
        "dropout_rate": 0.1
    },
    "training": {
        "training_stage": 1,
        "epochs": 10,
        "batch_size": 2,
        "seq_len": 32,
        "gradient_accumulation_steps": 1,
        "validation_split": 0.1,
        "contrastive_margin": 1.0,
        "num_candidates": 4,
        "data_dir": "data",
        "sft_data_dir": "sft_data",
        "weights_path": "model_weights.npz",
        "checkpoint_path": "checkpoint.npz",
        "early_stopping_patience": 3,
        "best_model_path": "best_model.npz"
    },
    "optimizer": {
        "learning_rate": 0.001,
        "beta1": 0.9,
        "beta2": 0.999,
        "epsilon": 1e-8,
        "weight_decay": 0.01,
        "max_norm": 1.0
    },
    "scheduler": {
        "warmup_steps": 10,
        "min_lr": 1e-5
    },
    "generation": {
        "start_text": "Пожалуйста, перечисли файлы в текущей директории. Используй инструмент 'list_files'.",
        "max_len": 100,
        "temperature": 0.0,
        "top_k": 1,
        "top_p": 0.0,
        "speculative_steps": 0,
        "value_threshold": -1.0,
        "max_thought_len": 50,
        "max_retries": 3,
        "max_turns": 10
    }
}
