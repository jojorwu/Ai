{
    "model": {
        "d_model": 64,
        "num_layers": 4,
        "num_heads": 8,
        "num_kv_heads": 2,
        "d_ff": 256,
        "max_seq_len": 128,
        "dropout_rate": 0.1,
        "num_experts": 8,
        "top_k_experts": 2
    },
    "vision": {
        "image_size": [224, 224],
        "patch_size": 16,
        "num_channels": 3
    },
    "evolution": {
        "pretrain_epochs": 5,
        "evolution_epochs": 10,
        "num_agents": 8,
        "num_survivors": 2,
        "batch_size": 16,
        "seq_len": 32,
        "gradient_accumulation_steps": 1,
        "validation_split": 0.1,
        "data_dir": "data",
        "weights_path": "model_weights.npz",
        "checkpoint_path": "checkpoint.npz",
        "early_stopping_patience": 3,
        "best_model_path": "best_model.npz",
        "moe_aux_loss_coeff": 0.01
    },
    "optimizer": {
        "learning_rate": 0.0001,
        "beta1": 0.9,
        "beta2": 0.999,
        "epsilon": 1e-8,
        "weight_decay": 0.01,
        "max_norm": 1.0
    },
    "ltm": {
        "surprise_threshold": 1.0,
        "optimizer": {
            "learning_rate": 1e-5,
            "beta1": 0.9,
            "beta2": 0.999,
            "epsilon": 1e-8,
            "weight_decay": 0.01
        }
    },
    "scheduler": {
        "warmup_steps": 10,
        "min_lr": 1e-5
    },
    "generation": {
        "start_text": "Пожалуйста, перечисли файлы в текущей директории. Используй инструмент 'list_files'.",
        "max_len": 100,
        "temperature": 0.0,
        "top_k": 1,
        "top_p": 0.0,
        "speculative_steps": 0,
        "value_threshold": -1.0,
        "max_thought_len": 50,
        "max_retries": 3,
    "max_turns": 10,
    "context_window_size": 2048
    },
    "hardware": {
        "device": "cpu"
    }
}
